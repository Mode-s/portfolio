---
import { Image } from 'astro:assets';
import footerBgImage from '../assets/images/footer-bg.jpg';
---
<footer class="footer">
  <Image
    src={footerBgImage}
    alt=""
    class="footer-bg"
    widths={[768, 1280]}
    sizes="100vw"
    loading="lazy"
    aria-hidden="true"
  />
  <ul class="footer-sns">
    <li>
      <a class="footer-sns-link" href="https://x.com/_mechaxx" target="_blank" rel="noopener noreferrer">
        <span class="footer-sns-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
          </svg>
        </span>
        <span class="footer-sns-name">@_mechaxx</span>
      </a>
    </li>
    <li>
      <a class="footer-sns-link" href="https://www.instagram.com/" target="_blank" rel="noopener noreferrer">
        <span class="footer-sns-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
            <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
          </svg>
        </span>
        <span class="footer-sns-name">@username</span>
      </a>
    </li>
  </ul>
  <small class="footer-copyright">© 2026 Mecha</small>
</footer>


<style lang="scss">
  @use '../styles/variables' as *;
  @use '../styles/mixins' as *;
  
  //──────────────────  Footer  ──────────────────//
  .footer {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
    padding: 48px 24px;

    &::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      z-index: 1;
      width: 100%;
      height: 100%;
      background-color: rgba(22, 22, 22, 0.6);
    }
  }

  //──────────────────  Footer bg  ──────────────────//
  .footer-bg {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  //──────────────────  Footer sns  ──────────────────//
  .footer-sns {
    position: relative;
    display: flex;
    align-items: center;
    gap: 12px;
    z-index: 2;
  }

  //──────────────────  Footer sns link  ──────────────────//
  .footer-sns-link {
    display: flex;
    align-items: center;
    gap: 8px;
    line-height: 1;
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    transition: opacity 0.2s ease;

    &:hover {
      opacity: 0.5;
    }

    @include reduced-motion {
      transition: none;
    }
  }

  //──────────────────  Footer sns icon  ──────────────────//
  .footer-sns-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 16px;
    height: 16px;

    svg {
      width: 100%;
      height: 100%;
    }
  }

  //──────────────────  Footer sns name  ──────────────────//
  .footer-sns-name {
    color: $c-text;
  }

  //──────────────────  Footer copyright  ──────────────────//
  .footer-copyright {
    position: relative;
    z-index: 1;
    font-size: 0.625rem;
    letter-spacing: 0.1em;
    opacity: 0.8;
  }
</style>

