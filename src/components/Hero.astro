<section class="hero">
  <a href="/" class="hero-logo" aria-label="ホームへ戻る">
    <img class="hero-logo-image" src="/images/logo1.svg" alt="ロゴ" />
  </a>
  <div class="hero-inner">
    <div class="hero-content">
      <div class="hero-label">portfolio</div>
      <h1 class="hero-title">mecha</h1>
    </div>
    <p class="hero-scroll" aria-hidden="true">SCROLL</p>
  </div>
</section>

<style lang="scss">
  @use '../styles/variables' as *;
  @use '../styles/mixins' as *;

  //――――――――――――――――――――――――――　Hero ――――――――――――――――――――――――――――//
	.hero {
		position: relative;
		width: 100%;
		height: 100svh;
		background-image: url('/images/hero.jpg');
		background-size:  cover;
		background-position: center;
		overflow: hidden;

    &::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      z-index: $z-base;
      display: block;
      width: 100%;
      height: 100%;
      background-color: rgba(10, 10, 8, 0.3);
    }
	}
  //――――――――――――――――――――――――――　Hero Logo ――――――――――――――――――――――――――――//
  .hero-logo {
    position: absolute;
    top: 24px;
    left: 24px;
    z-index: $z-base + 2;

    .hero-logo-image {
      height: 50px; // ← サイズはここで調整
      width: auto;
    }
  }
  //――――――――――――――――――――――――――　Hero inner ――――――――――――――――――――――――――――//
  .hero-inner {
    position: relative;
    z-index: $z-base + 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    width: 100%;
    height: 100%;
    padding: 40px;
  }
  //――――――――――――――――――――――――――　Hero content ――――――――――――――――――――――――――――//
  .hero-content {
    display: flex;
    flex-direction: column;
    margin-top: auto;
  }
  //――――――――――――――――――――――――――　Hero label ――――――――――――――――――――――――――――//
  .hero-label {
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    opacity: 0.7;
  }

  //――――――――――――――――――――――――――　Hero title ――――――――――――――――――――――――――――//
  .hero-title {
    font-family: 'Libre Barcode 39', cursive;
    font-size: 3.5rem;
    letter-spacing: 0.04em;
    line-height: 1.2;
  }

  //――――――――――――――――――――――――――　Hero scroll ――――――――――――――――――――――――――――//
  .hero-scroll {
    position: absolute;
    align-self: flex-end;
    bottom: 40px;
    writing-mode: vertical-rl;
    font-size: 0.625rem;
    letter-spacing: 0.16em;
  }
</style>

<script>
  import { scramble } from '../utils/scramble';

  const initHero = () => {
    const label = document.querySelector<HTMLElement>('.hero-label');
    const scroll = document.querySelector<HTMLElement>('.hero-scroll');

    if (!label && !scroll) return;

    const fire = () => {
      if (label) scramble(label, 800, 0);
      if (scroll) scramble(scroll, 1200, 200);
    };

    if (sessionStorage.getItem('loaded') === 'true') {
      fire();
    } else {
      window.addEventListener('loading:complete', fire, { once: true });
    }
  };

  document.addEventListener('astro:page-load', initHero);
</script>