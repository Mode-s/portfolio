<script is:inline>
  // FOUC防止：訪問済みなら HTML 描画と同時にローディング要素を消す
  if (sessionStorage.getItem('loaded') === 'true') {
    document.documentElement.dataset.loaded = 'true';
  }
</script>

<div class="loading" data-js="loading">
  <div class="loading-inner">
    <p class="loading-name">shota portfolio</p>
    <p class="loading-percent" data-js="loading-percent">0%</p>
    <div class="loading-bar-track">
      <div class="loading-bar" data-js="loading-bar"></div>
    </div>
  </div>
</div>

<style lang="scss">
  @use '../styles/variables' as *;
  @use '../styles/mixins' as *;

  :global(html[data-loaded="true"]) .loading {
    display: none;
  }

  //──────────────────  Loading  ──────────────────//
  .loading {
    position: fixed;
    top: 0;
    left: 0;
    z-index: $z-base + 10;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    background-color: rgb(10, 10, 8);
    transition: opacity 1s ease;

    @include reduced-motion {
      transition: none;
    }
  }

  //──────────────────  Loading inner  ──────────────────//
  .loading-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    width: min(400px, calc(100% - 48px)); // 左右24px余白
  }

  //──────────────────  Loading name  ──────────────────//
  .loading-name {
    font-size: 0.6875rem;
    letter-spacing: 0.2em;
    opacity: 0.5;
    text-transform: uppercase;
  }

  //──────────────────  Loading percent  ──────────────────//
  .loading-percent {
    font-size: 2rem;
    letter-spacing: 0.1em;
    font-variant-numeric: tabular-nums; // 数字の幅を固定してガタつき防止
  }

  //──────────────────  Loading bar track  ──────────────────//
  .loading-bar-track {
    width: 100%;
    height: 0.5px;
    background-color: rgba(204, 200, 190, 0.15);
  }

  //──────────────────  Loading bar  ──────────────────//
  .loading-bar {
    width: 100%;
    height: 100%;
    background-color: $c-text;
    transform: scaleX(0);
    transform-origin: left;
  }
</style>

<script>
  const loading = document.querySelector<HTMLElement>('[data-js="loading"]');
  const bar = document.querySelector<HTMLElement>('[data-js="loading-bar"]');
  const percent = document.querySelector<HTMLElement>('[data-js="loading-percent"]');

  // すでにこのセッションで一度ローディング済みの場合
  if (sessionStorage.getItem('loaded') === 'true') {
    // Hero / Header の `loading:complete` リスナー登録が完了するのを待ってから発火
    setTimeout(() => {
      window.dispatchEvent(new CustomEvent('loading:complete'));
    }, 0);
  } else if (loading && bar && percent) {
    sessionStorage.setItem('loaded', 'true');

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    document.body.style.overflow = 'hidden';

    const complete = () => {
      loading.style.opacity = '0';
      setTimeout(() => {
        loading.style.display = 'none';
        document.body.style.overflow = '';
        window.dispatchEvent(new CustomEvent('loading:complete'));
      }, 1200);
    };

    if (prefersReducedMotion) {
      complete();
    } else {
      const duration = 2500;
      const startTime = performance.now();

      const tick = (now: number) => {
        const elapsed = now - startTime;
        const progress = Math.min(elapsed / duration, 1);

        bar.style.transform = `scaleX(${progress})`;
        percent.textContent = `${Math.floor(progress * 100)}%`;

        if (progress < 1) {
          requestAnimationFrame(tick);
        } else {
          percent.textContent = '100%';
          complete();
        }
      };

      requestAnimationFrame(tick);
    }
  }
</script>