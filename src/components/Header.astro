---

<header class="header" data-js="header">
  <nav class="header-nav">
    <ul class="header-nav-list" data-js="header-nav-list">
      <li><a href="/#hero" class="header-nav-link">HOME</a></li>
      <li><a href="/#works" class="header-nav-link">WORKS</a></li>
      <li><a href="/#about" class="header-nav-link">ABOUT</a></li>
      <li><a href="/#contact" class="header-nav-link">CONTACT</a></li>
    </ul>
    <div class="header-nav-current" data-js="header-nav-current" aria-hidden="true"></div>
  </nav>
  <!-- Tablet / SP : ハンバーガーボタン -->
  <button class="header-hamburger" data-js="header-hamburger" aria-label="メニューを開く" aria-expanded="false" type="button">
    <span class="header-hamburger-line" aria-hidden="true"></span>
    <span class="header-hamburger-line" aria-hidden="true"></span>
  </button>
  <!-- Tablet/SP：全画面オーバーレイ -->
  <div class="header-overlay" data-js="header-overlay" aria-hidden="true">
    <ul class="header-overlay-list">
      <li><a href="/#hero" class="header-overlay-link">HOME</a></li>
      <li><a href="/#works" class="header-overlay-link">WORKS</a></li>
      <li><a href="/#about" class="header-overlay-link">ABOUT</a></li>
      <li><a href="/#contact" class="header-overlay-link">CONTACT</a></li>
    </ul>
  </div>
  <ul class="header-sns">
    <li>
      <a class="header-sns-link" href="" target="_blank" rel="noopener noreferrer" aria-label="Twitter">
        <span class="header-sns-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
          </svg>
        </span>
        <span class="header-sns-label">Twitter</span>
        <span class="header-sns-arrow">↗</span>
      </a>
    </li>
    <li>
      <a class="header-sns-link" href="google.com" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
        <span class="header-sns-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
            <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
          </svg>
        </span>
        <span class="header-sns-label">Instagram</span>
        <span class="header-sns-arrow" aria-hidden="true">↗</span>
      </a>
    </li>
  </ul>
</header>

<style lang="scss">
  @use '../styles/variables' as *;
  @use '../styles/mixins' as *;

  //──────────────────  Header  ──────────────────//
  .header {
    position: fixed;
    top: 0;
    left: 0;
    z-index: $z-base + 2;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    width: 100%;
    padding: 16px 24px;
  }

  //──────────────────  Header nav  ──────────────────//
  .header-nav {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);

    @include tablet {
      display: none;
    }
  }

  //──────────────────  Header nav list  ──────────────────//
  .header-nav-list {
    position: relative; // インジケーターの基準
    display: flex;
    align-items: center;
    padding: 3px;
    border: 0.5px solid $c-text;
    border-radius: 5px;
  }

  //──────────────────  Header nav current (active indicator)  ──────────────────//
  .header-nav-current {
    position: absolute;
    top: 3px;
    left: 0;
    z-index: 0;
    width: var(--current-w, 0);
    height: calc(100% - 6px);
    transform: translateX(var(--current-x, 3px));
    background-color: $c-text;
    border-radius: 5px;
    transition: transform 0.3s ease, width 0.3s ease;
    pointer-events: none;

  }

  //──────────────────  Header nav link  ──────────────────//
  .header-nav-link {
    position: relative;
    z-index: 1;
    display: block;
    padding: 6px 16px;
    color: $c-text;
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    transition: color 0.3s ease;

    &.is-active {
      color: #000; // ───────────────────────────あとで変更
    }

    &:hover {
      opacity: 0.7; // ───────────────────────────あとで変更
    }

  }

  //──────────────────  Header Hamburger  ──────────────────//
  .header-hamburger {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 6px;
    width: 100px; // ラインの長さ調整
    height: 44px;
    cursor: pointer;

    @include tablet {
      display: flex;
    }
  }

  //──────────────────  Header hamburger line  ──────────────────//
  .header-hamburger-line {
    display: block;
    width: 100%;
    height: 0.5px;
    background-color: $c-text;
    transform-origin: center;
    transition: transform 0.3s ease, opacity 0.3s ease;

    @include reduced-motion {
      transition: none;
    }
  }
  //──────────────────  Header hamburger open state  ──────────────────//
  .header-hamburger.is-open {
    z-index: $z-base + 4;
    .header-hamburger-line:nth-child(1) {
      transform: translateY(3.5px) rotate(10deg);
    }
    .header-hamburger-line:nth-child(2) {
      transform: translateY(-3.5px) rotate(-10deg);
    }
  }

  //──────────────────  Header overlay  ──────────────────//
  .header-overlay {
    position: fixed;
    top: 0;
    left: 0;
    z-index: $z-base + 3; // ヘッダー(+2)より1段上
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    background-color: rgba(10, 10, 8, 0.96);
    opacity: 0;
    visibility: hidden; // opacity:0だけだとキーボード操作が貫通するため
    pointer-events: none;
    transition: opacity 0.4s ease, visibility 0.4s ease;

    @include reduced-motion {
      transition: none;
    }
  }

  //──────────────────  Header overlay open state  ──────────────────//
  .header-overlay.is-open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  //──────────────────  Header overlay list  ──────────────────//
  .header-overlay-list {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 40px;
  }

  //──────────────────  Header overlay link  ──────────────────//
  .header-overlay-link {
    position: relative;
    font-size: 1rem;
    letter-spacing: 0.1em;

    &::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 0;
      z-index: -1;
      width: 100%;
      height: 0.7em;
      background-color: rgba(164, 245, 231, 0.35);
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 0.5s ease;

      @include reduced-motion {
        transition: none;
      }
    }

    &:hover::after {
      transform: scaleX(1);
    } 
  }

  //──────────────────  Header sns  ──────────────────//
  .header-sns {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 5px;
  }

  //──────────────────  Header sns link  ──────────────────//
  .header-sns-link {
    display: flex;
    align-items: center;
    height: 30px;
    border: 0.5px solid $c-text;
    border-radius: 20px;
    font-size: 0.625rem;
    letter-spacing: 0.06em;
    overflow: hidden;
  }

  //──────────────────  Header sns icon  ──────────────────//
  .header-sns-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 30px;
    height: 30px;

    svg {
      width: 14px;
      height: 14px;
    }
  }

  //──────────────────  Header sns label (通常時は0幅で隠す)  ──────────────────//
  .header-sns-label {
    max-width: 0;
    padding-right: 0;
    overflow: hidden;
    white-space: nowrap;
    opacity: 0;
    transition: max-width 0.3s ease, padding-left 0.3s ease, opacity 0.3s ease;

    @include reduced-motion {
      transition: none;
    }
  }

  //──────────────────  Header sns label (通常時は0幅で隠す)  ──────────────────//
  .header-sns-arrow {
    flex-shrink: 0;
    max-width: 0;
    padding-right: 0;
    overflow: hidden;
    opacity: 0;
    transition: max-width 0.3s ease, padding-right 0.3s ease, opacity 0.3s ease;

    @include reduced-motion {
      transition: none;
    }
  }

  //──────────────────  Header sns link :hover  ──────────────────//
  .header-sns-link:hover {

    .header-sns-label {
      max-width: 100px;
      padding-right: 6px;
      opacity: 1;
    }

    .header-sns-arrow {
      max-width: 1em;
      padding-right: 15px;
      opacity: 1;
    }

  }
</style>

<script>
  import { scramble } from '../utils/scramble';

  const list = document.querySelector<HTMLElement>('[data-js="header-nav-list"]');
  const current = document.querySelector<HTMLElement>('[data-js="header-nav-current"]');
  const links = list?.querySelectorAll<HTMLAnchorElement>('.header-nav-link');

  if (list && current && links && links.length > 0) {
    const updateCurrent = (target: HTMLElement) => {
      const targetRect = target.getBoundingClientRect();
      const listRect = list.getBoundingClientRect();
      const x = targetRect.left - listRect.left;

      current.style.setProperty('--current-x', `${x}px`);
      current.style.setProperty('--current-w', `${targetRect.width}px`);

      links.forEach((link) => link.classList.toggle('is-active', link === target));


    };

    requestAnimationFrame(() => updateCurrent(links[0]));


    links.forEach((link) => {
      link.addEventListener('click', () => updateCurrent(link));
    });


    window.addEventListener('resize', () => {
      const active = list.querySelector<HTMLAnchorElement>('.header-nav-link.is-active');
      if (active) updateCurrent(active);
    });

    // ── スクランブルはここで1回だけ呼ぶ（イベントリスナーの外）──
    links.forEach((link, i) => {
      scramble(link, 500, i * 100);
    });
  }

  const hamburger = document.querySelector<HTMLButtonElement>('[data-js="header-hamburger"]');
  const overlay = document.querySelector<HTMLElement>('[data-js="header-overlay"]');
  const overlayLinks = overlay?.querySelectorAll<HTMLAnchorElement>('.header-overlay-link');

  if (hamburger && overlay) {

  // ── 開閉の核となる処理 ──────────────────────────────────
    const open = () => {
      hamburger.classList.add('is-open');
      overlay.classList.add('is-open');
      hamburger.setAttribute('aria-expanded', 'true');
      hamburger.setAttribute('aria-label', 'メニューを閉じる');
      overlay.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden'; // スクロールロック

      // ── オーバーレイリンクにスクランブル ──
      overlayLinks?.forEach((link, i) => {
        scramble(link, 600, i * 80);
      });
    };

    const close = () => {
      hamburger.classList.remove('is-open');
      overlay.classList.remove('is-open');
      hamburger.setAttribute('aria-expanded', 'false');
      hamburger.setAttribute('aria-label', 'メニューを開く');
      overlay.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = ''; // スクロールロック解除
    };

    const toggle = () => {
      hamburger.classList.contains('is-open') ? close() : open();
    };

    // ── イベント登録 ─────────────────────────────────────────
    hamburger.addEventListener('click', toggle);

    // オーバーレイリンクをクリックしたら閉じる
    overlayLinks?.forEach((link) => {
      link.addEventListener('click', close);
    });

    // ESCキーで閉じる
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && hamburger.classList.contains('is-open')) {
        close();
        hamburger.focus(); // フォーカスをボタンに戻す
      }
    });
  }
</script>