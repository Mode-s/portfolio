---
---

<header class="header" data-js="header" transition:persist>
  <nav class="header-nav">
    <ul class="header-nav-list" data-js="header-nav-list">
      <li><a href="/" class="header-nav-link">HOME</a></li>
      <li><a href="/about" class="header-nav-link">ABOUT</a></li>
      <li><a href="/projects" class="header-nav-link">PROJECTS</a></li>
      <li><a href="/contact" class="header-nav-link">CONTACT</a></li>
    </ul>
    <div class="header-nav-current" data-js="header-nav-current" aria-hidden="true"></div>
  </nav>
  <!-- Tablet / SP : ハンバーガーボタン -->
  <button class="header-hamburger" data-js="header-hamburger" aria-label="メニューを開く" aria-expanded="false" type="button">
    <span class="header-hamburger-line" aria-hidden="true"></span>
    <span class="header-hamburger-line" aria-hidden="true"></span>
  </button>
  <!-- Tablet/SP：全画面オーバーレイ -->
  <div class="header-overlay" data-js="header-overlay" aria-hidden="true">
    <ul class="header-overlay-list">
      <li><a href="/" class="header-overlay-link">HOME</a></li>
      <li><a href="/about" class="header-overlay-link">ABOUT</a></li>
      <li><a href="/projects" class="header-overlay-link">PROJECTS</a></li>
      <li><a href="/contact" class="header-overlay-link">CONTACT</a></li>
    </ul>
  </div>
  <ul class="header-sns">
    <li>
      <a class="header-sns-link" href="https://x.com/_mechaxx" target="_blank" rel="noopener noreferrer" aria-label="Twitter">
        <span class="header-sns-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
          </svg>
        </span>
        <span class="header-sns-label">X（旧Twitter）</span>
        <span class="header-sns-arrow">↗</span>
      </a>
    </li>
    <li>
      <a class="header-sns-link" href="https://www.instagram.com/_mexxha/?hl=ja" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
        <span class="header-sns-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
            <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
          </svg>
        </span>
        <span class="header-sns-label">Instagram</span>
        <span class="header-sns-arrow" aria-hidden="true">↗</span>
      </a>
    </li>
  </ul>
</header>

<style lang="scss">
  @use '../styles/variables' as *;
  @use '../styles/mixins' as *;

  //──────────────────  Header  ──────────────────//
  .header {
    position: fixed;
    top: 0;
    left: 0;
    z-index: $z-base + 2;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    width: 100%;
    padding: 16px 24px;
  }

  //──────────────────  Header nav  ──────────────────//
  .header-nav {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);

    @include tablet {
      display: none;
    }
  }

  //──────────────────  Header nav list  ──────────────────//
  .header-nav-list {
    position: relative; // インジケーターの基準
    display: flex;
    align-items: center;
    padding: 3px;
    border: 0.5px solid $c-text;
    border-radius: 5px;
  }

  //──────────────────  Header nav current (active indicator)  ──────────────────//
  .header-nav-current {
    position: absolute;
    top: 3px;
    left: 0;
    z-index: 0;
    width: var(--current-w, 0);
    height: calc(100% - 6px);
    transform: translateX(var(--current-x, 3px));
    background-color: $c-text;
    border-radius: 5px;
    pointer-events: none;

  }

  //──────────────────  Header nav link  ──────────────────//
  .header-nav-link {
    position: relative;
    z-index: 1;
    display: block;
    padding: 6px 16px;
    color: $c-text;
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    transition: color 0.3s ease;

    &.is-active {
      color: #000; // ───────────────────────────あとで変更
    }

    &:hover {
      opacity: 0.7; // ───────────────────────────あとで変更
    }

  }

  //──────────────────  Header Hamburger  ──────────────────//
  .header-hamburger {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 6px;
    width: 100px; // ラインの長さ調整
    height: 44px;
    cursor: pointer;

    @include tablet {
      display: flex;
    }
  }

  //──────────────────  Header hamburger line  ──────────────────//
  .header-hamburger-line {
    display: block;
    width: 100%;
    height: 1px;
    background-color: $c-text;
    transform-origin: center;
    transition: transform 0.3s ease, opacity 0.3s ease;

    @include reduced-motion {
      transition: none;
    }
  }
  //──────────────────  Header hamburger open state  ──────────────────//
  .header-hamburger.is-open {
    z-index: $z-base + 4;

    .header-hamburger-line:nth-child(1) {
      transform: translateY(4px) rotate(10deg);
    }
    .header-hamburger-line:nth-child(2) {
      transform: translateY(-4px) rotate(-10deg);
    }
  }

  //──────────────────  Header overlay  ──────────────────//
  .header-overlay {
    position: fixed;
    top: 0;
    left: 0;
    z-index: $z-base + 3; // ヘッダー(+2)より1段上
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    background-color: rgba(10, 10, 8, 0.96);
    opacity: 0;
    visibility: hidden; // opacity:0だけだとキーボード操作が貫通するため
    pointer-events: none;
    transition: opacity 0.4s ease, visibility 0.4s ease;

    @include reduced-motion {
      transition: none;
    }
  }

  //──────────────────  Header overlay open state  ──────────────────//
  .header-overlay.is-open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  //──────────────────  Header overlay list  ──────────────────//
  .header-overlay-list {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 40px;
  }

  //──────────────────  Header overlay link  ──────────────────//
  .header-overlay-link {
    position: relative;
    font-size: 1rem;
    letter-spacing: 0.1em;

    &::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 0;
      z-index: -1;
      width: 100%;
      height: 0.7em;
      background-color: rgba(164, 245, 231, 0.35);
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 0.5s ease;

      @include reduced-motion {
        transition: none;
      }
    }

    &:hover::after {
      transform: scaleX(1);
    } 
  }

  //──────────────────  Header sns  ──────────────────//
  .header-sns {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 5px;
  }

  //──────────────────  Header sns link  ──────────────────//
  .header-sns-link {
    display: flex;
    align-items: center;
    height: 30px;
    border: 0.5px solid $c-text;
    border-radius: 20px;
    font-size: 0.625rem;
    letter-spacing: 0.06em;
    overflow: hidden;
  }

  //──────────────────  Header sns icon  ──────────────────//
  .header-sns-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 30px;
    height: 30px;

    svg {
      width: 14px;
      height: 14px;
    }
  }

  //──────────────────  Header sns label (通常時は0幅で隠す)  ──────────────────//
  .header-sns-label {
    max-width: 0;
    padding-right: 0;
    overflow: hidden;
    white-space: nowrap;
    opacity: 0;
    transition: max-width 0.3s ease, padding-left 0.3s ease, opacity 0.3s ease;

    @include reduced-motion {
      transition: none;
    }
  }

  //──────────────────  Header sns label (通常時は0幅で隠す)  ──────────────────//
  .header-sns-arrow {
    flex-shrink: 0;
    max-width: 0;
    padding-right: 0;
    overflow: hidden;
    opacity: 0;
    transition: max-width 0.3s ease, padding-right 0.3s ease, opacity 0.3s ease;

    @include reduced-motion {
      transition: none;
    }
  }

  //──────────────────  Header sns link :hover  ──────────────────//
  .header-sns-link:hover {

    .header-sns-label {
      max-width: 100px;
      padding-right: 6px;
      opacity: 1;
    }

    .header-sns-arrow {
      max-width: 1em;
      padding-right: 15px;
      opacity: 1;
    }

  }
</style>

<script>
  import { scramble } from '../utils/scramble';

  // ─────────────────────────────────────────
  //  ナビ・インジケーター
  // ─────────────────────────────────────────
  const initHeaderNav = () => {
    const list = document.querySelector<HTMLElement>('[data-js="header-nav-list"]');
    const current = document.querySelector<HTMLElement>('[data-js="header-nav-current"]');
    const links = list?.querySelectorAll<HTMLAnchorElement>('.header-nav-link');

    if (!list || !current || !links || links.length === 0) return;

    // インジケーターの位置・サイズと is-active を更新
    // 直近の位置・サイズを保持（アニメーションの開始値に使う）
    let prevX = 3;
    let prevW = 0;
    let currentAnimation: Animation | null = null;

    const updateCurrent = (target: HTMLElement) => {
      
      const targetRect = target.getBoundingClientRect();
      const listRect = list.getBoundingClientRect();
      const nextX = targetRect.left - listRect.left;
      const nextW = targetRect.width;

      links.forEach((link) => link.classList.toggle('is-active', link === target));

      // CSS変数も同期させておく（リサイズ後やアニメ未対応環境用のフォールバック）
      current.style.setProperty('--current-x', `${nextX}px`);
      current.style.setProperty('--current-w', `${nextW}px`);

      // 既存のアニメーションをキャンセル
      if (currentAnimation) currentAnimation.cancel();

      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (prefersReducedMotion) {
        prevX = nextX;
        prevW = nextW;
        return;
      }

      if (prevW === 0) {
        prevX = nextX;
        prevW = nextW;
        return;
      }

      // Web Animations API でアニメーション
      currentAnimation = current.animate(
        [
          { transform: `translateX(${prevX}px)`, width: `${prevW}px` },
          { transform: `translateX(${nextX}px)`, width: `${nextW}px` },
        ],
        {
          duration: 450,
          easing: 'cubic-bezier(0.65, 0, 0.35, 1)',
          fill: 'forwards',
        }
      );

      prevX = nextX;
      prevW = nextW;
    };

    // 現在のURLからリンクを判定
    const resolveActiveLink = (): HTMLAnchorElement => {
      const path = window.location.pathname;

      const exact = Array.from(links).find((link) => {
        const href = link.getAttribute('href') ?? '';
        const linkPath = href.split('#')[0] || '/';
        return linkPath === path;
      });

      if (exact) return exact;

      const prefix = Array.from(links).find((link) => {
        const href = link.getAttribute('href') ?? '';
        const linkPath = href.split('#')[0];
        return linkPath && linkPath !== '/' && path.startsWith(`${linkPath}/`);
      });

      if (prefix) return prefix;

      return links[0];
    };

    document.addEventListener('astro:before-preparation', (event: any) => {
    const toUrl: URL | undefined = event.to;
    if (!toUrl) return;

    const path = toUrl.pathname;
    const target =
      Array.from(links).find((link) => {
        const href = link.getAttribute('href') ?? '';
        const linkPath = href.split('#')[0] || '/';
        return linkPath === path;
      }) ??
      Array.from(links).find((link) => {
        const href = link.getAttribute('href') ?? '';
        const linkPath = href.split('#')[0];
        return linkPath && linkPath !== '/' && path.startsWith(`${linkPath}/`);
      });

      if (target) updateCurrent(target);
    });

    const initialTarget = resolveActiveLink();
    updateCurrent(initialTarget);

    links.forEach((link) => {
      link.addEventListener('click', () => {
        const href = link.getAttribute('href') ?? '';
        const linkPath = href.split('#')[0] || '/';
        const currentPath = window.location.pathname;

        if (linkPath === currentPath) {
          updateCurrent(link);
        }
      });
    });

    window.addEventListener('resize', () => {
      const active = list.querySelector<HTMLAnchorElement>('.header-nav-link.is-active');
      if (active) updateCurrent(active);
    });

    const fireNavScramble = () => {
      links.forEach((link, i) => {
        scramble(link, 500, i * 100);
      });
    };

    const hasLoading = document.querySelector('[data-js="loading"]');
    const isFirstVisit = sessionStorage.getItem('loaded') !== 'true';

    if (hasLoading && isFirstVisit) {
      window.addEventListener('loading:complete', fireNavScramble, { once: true });
    } else {
      fireNavScramble();
    }
  };

  //  ───────────────── ハンバーガー / オーバーレイ ────────────────────
  const initHamburger = () => {
    const hamburger = document.querySelector<HTMLButtonElement>('[data-js="header-hamburger"]');
    const overlay = document.querySelector<HTMLElement>('[data-js="header-overlay"]');
    const overlayLinks = overlay?.querySelectorAll<HTMLAnchorElement>('.header-overlay-link');

    if (!hamburger || !overlay) return;

    const open = () => {
      hamburger.classList.add('is-open');
      overlay.classList.add('is-open');
      hamburger.setAttribute('aria-expanded', 'true');
      hamburger.setAttribute('aria-label', 'メニューを閉じる');
      overlay.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';

      overlayLinks?.forEach((link, i) => {
        scramble(link, 600, i * 80);
      });
    };

    const close = () => {
      hamburger.classList.remove('is-open');
      overlay.classList.remove('is-open');
      hamburger.setAttribute('aria-expanded', 'false');
      hamburger.setAttribute('aria-label', 'メニューを開く');
      overlay.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    };

    const toggle = () => {
      hamburger.classList.contains('is-open') ? close() : open();
    };

    hamburger.addEventListener('click', toggle);

    overlayLinks?.forEach((link) => {
      link.addEventListener('click', close);
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && hamburger.classList.contains('is-open')) {
        close();
        hamburger.focus();
      }
    });

    document.addEventListener('astro:after-swap', () => {
      if (hamburger.classList.contains('is-open')) close();
    });
  };

  initHeaderNav();
  initHamburger();
</script>